{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "rewrites": [
    {"source": "/studio/structure/:path*", "destination": "/studio/index.html"},
    {"source": "/studio/intent/:path*", "destination": "/studio/index.html"},
    {"source": "/studio/releases/:path*", "destination": "/studio/index.html"},
    {"source": "/static/:path*", "destination": "/studio/static/:path*"}
  ]
}
