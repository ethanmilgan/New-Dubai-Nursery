    "cms:seed": "sanity exec scripts/seed-cms.mjs --with-user-token --",
    "cms:verify": "node scripts/verify-cms.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.6.1",
    "@sanity/image-url": "^2.1.1",
    "next": "^16.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^6.13.2",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
