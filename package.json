{
  "name": "new-dubai-nursery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && sanity build out/studio --yes && node scripts/verify-static-build.mjs",
    "preview": "node scripts/preview-static.mjs",
    "start": "node scripts/preview-static.mjs",
    "cms:dev": "sanity dev",
